<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

  <changeSet id="003-create-store-tables" author="qrcode">
    <createTable tableName="store_tables">
      <column name="id" type="BIGINT" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>

      <column name="zone" type="VARCHAR(50)">
        <constraints nullable="false"/>
      </column>

      <column name="location_name" type="VARCHAR(150)">
        <constraints nullable="false"/>
      </column>

      <column name="qr_token" type="VARCHAR(255)">
        <constraints nullable="false" unique="true" uniqueConstraintName="uq_store_tables_qr_token"/>
      </column>

      <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
        <constraints nullable="false"/>
      </column>

      <!-- 5 Audit Fields -->
      <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>
      <column name="created_by" type="VARCHAR(255)"/>
      <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
        <constraints nullable="false"/>
      </column>
      <column name="updated_by" type="VARCHAR(255)"/>
      <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"/>
    </createTable>

    <createIndex tableName="store_tables" indexName="idx_store_tables_qr_token">
      <column name="qr_token"/>
    </createIndex>
  </changeSet>

</databaseChangeLog>
