# Application Configuration
PORT=8088
LOG_LEVEL=info

# PostgreSQL Configuration
POSTGRES_URL=jdbc:postgresql://localhost:5432/qr_code
POSTGRES_DB=qr_code
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DB_POOL_MAX=30
DB_POOL_MIN=10

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration (Base64-encoded HS256 key, >= 256 bit)
# Generate via: openssl rand -base64 48
JWT_SECRET=ZGV2LW9ubHktc2VjcmV0LWtleS1jaGFuZ2UtbWUtaW4tcHJvZHVjdGlvbi0xMjM0NTY3OA==
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# Cookie Configuration
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax

# CORS Configuration
CORS_ALLOWED_ORIGINS=*

# Mail Configuration (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# AWS S3 / RustFS Configuration
AWS_S3_ENDPOINT=https://your-s3-or-rustfs-endpoint.com
AWS_S3_REGION=us-east-1
AWS_S3_ACCESS_KEY=your_s3_access_key
AWS_S3_SECRET_KEY=your_s3_secret_key
AWS_S3_BUCKET_NAME=qrcode-media
